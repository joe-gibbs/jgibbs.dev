---
import Base from "./Base.astro";

export interface Props {
  title: string;
  description?: string;
  pubDate?: string | Date;
  wide?: boolean;
}

const { title, description, pubDate, wide = false } = Astro.props as Props;

const dateObject = pubDate ? new Date(pubDate) : undefined;
const isoDate = dateObject ? dateObject.toISOString().split("T")[0] : undefined;
const formattedDate = dateObject
  ? dateObject.toLocaleDateString("en-AU", { day: "2-digit", month: "short", year: "numeric" })
  : undefined;
---
<Base title={title} description={description}>
  <main class:list={{ "main-wide": wide }}>
    <h1>{title}</h1>
    {formattedDate && (
      <p class="post-date">
        <small><time datetime={isoDate}>{formattedDate}</time></small>
      </p>
    )}
    <slot name="nav" />
    <slot />
  </main>
</Base>


